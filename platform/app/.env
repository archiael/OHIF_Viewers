##
# Environment: Default
#
# We're using this to set variables for development.
# Please feel free to delete or modify this file for your own setup.
# Be careful not to commit anything sensitive to source control.
#

PUBLIC_URL=/
APP_CONFIG=config/default.js
USE_HASH_ROUTER=false

APP_ENCRYPTION_KEY=>}I>o#S?hYWfcB7B
APP_ENCRYPTION_IV=>}I>o#S?hYWfcB7B

# DCM4CHEE 프록시 설정 (dev:dcm4chee 명령어에서 사용)
# 단일 타겟 방식 (모든 context가 같은 서버로)
# DCM4CHEE_PROXY_TARGET=http://192.168.0.202:8083
# DCM4CHEE_PROXY_CONTEXTS=/dicomweb,/v2/auth

# 멀티 타겟 방식 (context별로 다른 서버)
DCM4CHEE_DICOMWEB_TARGET=http://192.168.0.202:8083
DCM4CHEE_API_TARGET=http://192.168.0.202:8083
