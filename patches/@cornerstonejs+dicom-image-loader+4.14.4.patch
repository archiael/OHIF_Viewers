+/**
+ * Emscripten _setThrew Shim for Web Worker
+ *
+ * @description
+ * @cornerstonejs/codec-openjph WASM 모듈에서 _setThrew 함수가 정의되지 않아
+ * HTJ2K 디코딩 시 예외가 발생하면 "_setThrew is not defined" 오류가 발생합니다.
+ *
+ * 이 shim은 Web Worker 환경에서 Emscripten의 예외 처리 메커니즘을 위한 fallback을 제공합니다.
+ *
+ * @see https://github.com/emscripten-core/emscripten/issues/15330
+ * @see https://github.com/emscripten-core/emscripten/issues/22227
+ */
+(function installSetThrewShimForWorker() {
+  // Web Worker 환경에서는 self가 전역 객체
+  const globalObj = typeof self !== 'undefined' ? self : (typeof globalThis !== 'undefined' ? globalThis : {});
+
+  // 이미 정의되어 있으면 건너뛰기
+  if (typeof globalObj._setThrew === 'function') {
+    return;
+  }
+
+  // Emscripten 예외 상태 변수
+  globalObj.__THREW__ = 0;
+  globalObj.__threwValue = 0;
+
+  /**
+   * Emscripten _setThrew 함수 구현
+   *
+   * @param {number} threw - 예외 발생 여부 (0 또는 1)
+   * @param {number} value - 예외 값
+   */
+  globalObj._setThrew = function(threw, value) {
+    if (globalObj.__THREW__ === 0) {
+      globalObj.__THREW__ = threw;
+      globalObj.__threwValue = value;
+    }
+  };
+
+  console.log('[HTJ2K-Worker] _setThrew shim installed for OpenJPH WASM exception handling');
+})();
