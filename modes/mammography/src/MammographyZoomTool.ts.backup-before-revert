/**
 * Custom Zoom Tool for Mammography
 * Zooms from the chest wall edge (midline) instead of cursor position
 */

import { getEnabledElement } from '@cornerstonejs/core';
import { ZoomTool } from '@cornerstonejs/tools';
import { getMidlineAnchor, recenterToCanvasPoint } from './utils/mammographyMidline';

/**
 * MammographyZoomTool - A specialized zoom tool that always zooms from the chest wall edge
 * For right breast (R): zooms from right edge
 * For left breast (L): zooms from left edge
 */
class MammographyZoomTool extends ZoomTool {
  static toolName = 'MammographyZoom';

  constructor(toolProps = {}, defaultToolProps = {}) {
    super(toolProps, defaultToolProps);
  }

  /**
   * Override the zoom method to pin chest wall to edge
   */
  _dragCallback(evt) {
    const { element, deltaPoints } = evt.detail;
    const enabledElement = getEnabledElement(element);
    const { viewport } = enabledElement;

    if (!viewport) {
      return;
    }

    // Get zoom delta from mouse movement
    const zoomDelta = deltaPoints.canvas[1] / viewport.element.clientHeight;
    const currentZoom = viewport.getZoom();
    const newZoom = currentZoom + currentZoom * zoomDelta;

    if (newZoom <= 0) {
      return;
    }

    // Get laterality and target canvas position
    const { laterality, canvasPoint: targetCanvas } = getMidlineAnchor(viewport);

    // Apply zoom first
    viewport.setZoom(newZoom);
    viewport.render();

    // Now reposition to stick chest wall to edge
    // Get the current image bounds in world coordinates
    const imageBounds = viewport.getImageData?.()?.getBounds?.();
    if (!imageBounds) {
      return;
    }

    const camera = viewport.getCamera();
    if (!camera) {
      return;
    }

    // Calculate which world coordinate should be at the target canvas edge
    // For right laterality: the rightmost part of the image should be at the right canvas edge
    // For left laterality: the leftmost part of the image should be at the left canvas edge
    let targetWorldX;
    if (laterality === 'R') {
      // Right edge of image bounds
      targetWorldX = imageBounds[1]; // max X
    } else if (laterality === 'L') {
      // Left edge of image bounds
      targetWorldX = imageBounds[0]; // min X
    } else {
      return; // No laterality, don't adjust
    }

    // Convert target canvas point to world coordinates
    const canvasCenter = [viewport.canvas.width / 2, viewport.canvas.height / 2];
    const canvasOffsetX = targetCanvas[0] - canvasCenter[0];

    // Calculate where the focal point needs to be
    const newFocalPointX = targetWorldX - canvasOffsetX / newZoom;

    // Shift camera to new focal point
    const shiftX = newFocalPointX - camera.focalPoint[0];

    const newCamera = {
      ...camera,
      focalPoint: [newFocalPointX, camera.focalPoint[1], camera.focalPoint[2]],
      position: [camera.position[0] + shiftX, camera.position[1], camera.position[2]]
    };

    viewport.setCamera(newCamera);
    viewport.render();
  }
}

export default MammographyZoomTool;
